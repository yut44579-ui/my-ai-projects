# AI 商业项目助理 —— 环境变量样例
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，绝不要提交真实口令。

# --- 应用 ---
APP_NAME=biz-assistant
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api
# D6：时区固定 Asia/Shanghai，不要改
TIMEZONE=Asia/Shanghai

# --- 数据库（MySQL 8，独立库 biz_assistant；禁止连 sales-report-agent 的库）---
# ★★ 下面 5 行是必填项：漏填/填错，服务和测试都会直接连不上库 ★★
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=biz_assistant

# 两种写法二选一：
#   1) 直接给完整连接串（优先级最高，填了它上面 5 行可忽略）
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/biz_assistant?charset=utf8mb4
#   2) 给分项，由程序拼装（默认走这条）
DB_ECHO=false

# --- CORS（前端 Vite 开发服务器地址）---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

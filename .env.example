# ════════════════════════════════════════════════════════════════════════
# sales-report-agent · 环境变量样例
# ════════════════════════════════════════════════════════════════════════
# 用法：复制成 `.env`（同目录），填上自己的值。`.env` 已被 .gitignore 挡住，
# 不会进版本库；`.env.example` 只是模板，**不要**往里写真实 Key。
#
#     cp .env.example .env        # Windows: copy .env.example .env
#
# 本文件里的每一项都来自**代码真实读取**（文件:行号逐条标注）。
# 没被代码读取的名字一律不写进来 —— 写了就是假配置，填了也没用。
#
# 空白项 = 用代码里的默认值。除「必需」那项外，全部**可以整份留空**。
#
# ── 两条"看起来像但没有写进来"的，说明理由 ──────────────────────────
#   · REVIEW_APPROVE / REVIEW_REJECT / REVIEW_DISABLE / REVIEW_ENABLE /
#     REVIEW_ACTIONS —— 这 5 个**不是环境变量**。它们是 app/accounts.py:71-75
#     里定义的普通 Python 常量（值为 "approve" / "reject" / "disable" /
#     "enable" 及其元组），代码里**没有任何** os.environ 去读它们。
#     写进这里会让人以为"改这里就能改审批动作"，那是错的（要改得改代码）。
#   · CLAUDE_CODE_MAX_CONTEXT_TOKENS —— scripts/auto_pipeline.py:52 只是把它
#     **写进子进程**（给 Claude Code CLI 用），项目自身从不读它。属运维/工具链
#     开关，不是本服务的配置，放进运行配置里会造成误解。
# ════════════════════════════════════════════════════════════════════════


# ── 必需 ───────────────────────────────────────────────────────────────
# LLM Key（app/ai/llm.py:48 API_KEY_ENV）。
# 不填**不是崩溃**，是降级：llm.available() 返回 False，问答走关键词匹配并
# 明确告知"未接 LLM"。要真的能问答就必须填。
# 取值示例形如 sk-xxxxxxxx（可从 https://platform.deepseek.com 申请）——**别把真值提交上来**。
DEEPSEEK_API_KEY=


# ── 可选：LLM 参数（app/ai/llm.py）────────────────────────────────────
# 都有默认值，普通使用**一般不用填**；要换模型/换厂商/调超时才用。
# 默认 https://api.deepseek.com（app/ai/llm.py:39 DEFAULT_BASE_URL）
# 例：换成自建/代理网关 → https://your-gateway.example.com/v1
SRA_LLM_BASE_URL=

# 默认 deepseek-flash（app/ai/llm.py:38 DEFAULT_MODEL）
SRA_LLM_MODEL=

# 单次回答的最大 token 数，默认 4000（app/ai/llm.py:43）。
# 注意：本项目用的是**推理模型**，思考过程也占额度；给小了会出现"思考没结束就被
# 截断"→ 正文为空（见 app/ai/llm.py 文件头"推理模型的坑"）。
SRA_LLM_MAX_TOKENS=

# 单次请求超时秒数，默认 180（app/ai/llm.py:42）。
# 给得比常见默认宽，因为推理模型"想"得慢，掐太紧会把正常请求掐成失败。
SRA_LLM_TIMEOUT=


# ── 可选：目录覆盖（app/repositories/json_store.py）──────────────────
# 全部都有默认值（见下方），**一般不用填**。只有想把状态/产出挪到别处
# （换盘、放共享目录、跑测试时做隔离）才改。
# 相对路径按**进程当前工作目录**解析，建议一律写绝对路径。

# 执行记录/上传记录/任务/账号 JSON 所在目录；默认 <项目根>/state
# （app/repositories/json_store.py:68）
SRA_STATE_DIR=

# 表格上传文件的落盘目录；默认 <项目根>/data/uploads（json_store.py:73）
SRA_UPLOAD_DIR=

# 产出报表（xlsx/Word/Excel/Markdown）的目录；默认 <项目根>/outputs（json_store.py:80）
SRA_OUTPUT_DIR=

# Word/PDF **原文**的落盘目录；默认 <项目根>/data/documents（json_store.py:91）
# 与 SRA_UPLOAD_DIR 是两条独立输入管道（表格 vs 文档），刻意分开。
SRA_DOC_DIR=


# ── 开发/测试专用（正常使用**一般不用填**）────────────────────────────
# 跑 tests/ 的落盘解析缓存开关（tests/conftest.py:73：`!= "0"` 即启用）。
# 默认就是开（留空/不填即开）：把 54 万行的 xlsx 解析结果按文件 SHA256 缓存到
# data/.cache/，全量测试从一个多小时降到几分钟。只有怀疑"缓存掩盖了真问题"
# 时才显式置 0 关掉（代价：测试会慢很多）。
# 与服务运行无关 —— 只在跑 pytest 时被读。
SRA_TEST_CACHE=
